<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HezbClips</AssemblyName>
    <RootNamespace>HezbClips.App</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/logo.png" />
    <Resource Include="Assets/logo-full.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HezbClips.Core\HezbClips.Core.csproj" />
    <ProjectReference Include="..\HezbClips.Capture\HezbClips.Capture.csproj" />
  </ItemGroup>

</Project>
