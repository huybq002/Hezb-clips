<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HezbClips</AssemblyName>
    <RootNamespace>HezbClips.App</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets/app-light.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="browser-extension\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/app-dark.ico" />
    <Resource Include="Assets/app-light.ico" />
    <Resource Include="Assets/logo-dark.png" />
    <Resource Include="Assets/logo-light.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HezbClips.Core\HezbClips.Core.csproj" />
    <ProjectReference Include="..\HezbClips.Capture\HezbClips.Capture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- the Tesseract package also ships 32-bit natives; the app is win-x64 only, so leave them out of build and publish output -->
  <Target Name="DropTesseractX86" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_DropX86 Include="@(None)" Condition="$([System.String]::new('%(None.Link)').StartsWith('x86'))" />
      <None Remove="@(_DropX86)" />
    </ItemGroup>
  </Target>
</Project>
